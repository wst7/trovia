{
  "name": "trovia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lightningcss": "1.29.2"
  },
  "devDependencies": {
    "lightningcss": "1.29.2",
    "patch-package": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "scripts": {
    "dev": "npm run dev -w @trovia/web",
    "dev:landing": "npm run dev -w @trovia/landing",
    "dev:mobile": "npm run start -w @trovia/mobile",
    "mobile:ios": "npm run ios -w @trovia/mobile",
    "mobile:android": "npm run android -w @trovia/mobile",
    "mobile:typecheck": "npm run typecheck -w @trovia/mobile",
    "mobile:doctor": "npm run doctor -w @trovia/mobile",
    "mobile:export": "npm run export -w @trovia/mobile",
    "api:typecheck": "npm run typecheck -w @trovia/api",
    "build": "npm run build -w @trovia/web && npm run build -w @trovia/landing",
    "preview": "npm run preview -w @trovia/web",
    "preview:landing": "npm run preview -w @trovia/landing",
    "postinstall": "patch-package",
    "lint:comments": "node scripts/check-comments.mjs",
    "extension:test": "npm test -w @trovia/extension",
    "extension:pack": "npm run pack -w @trovia/extension"
  }
}
