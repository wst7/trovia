  "narrative": {
    "northStar": "记忆切片",
    "overview": "v3 用真白底与深墨字立住对比，全站只用系统黑体；字号整体上调，最小 11.5、正文 16、阅读 17/30。封面降为 60×76 的识别辅助；搜索结果先给「你记得的那一句」；问题在浅灰气泡里，回答在白卡片上，工具过程压成一行事实。",
    "keyCharacteristics": [
      "一个屏幕只有一个强调色位置。",
      "层级由字号、字重和 1px 发丝线承担；只有搜索框与卡片有 1–2px 的轻微抬起。",
      "首页一个输入框，问模型是一张独立入口卡。",
      "搜索结果是「封面 + 标题 + 真实命中句 + 命中原因」。",
      "收藏行是 60×76 封面 + 16.5 号标题；分组用 12 号字距标签 + 实线。",
      "状态先用形状编码，已完成的条目不写状态文字。"
    ],
    "rules": [
      "The One-Accent Rule：一屏只能有一个朱红动作。",
      "The No-Decoration Rule：不做齿孔、印章、贴纸这类图形隐喻。",
      "The Paired-Sync Rule：global.css 与 palette.ts 必须同步。",
      "The Shape-First Rule：没有形状差异就不算状态。"
    ],
    "dos": [
      "用字号、字重和留白做层次，用发丝线分组。",
      "首页保持「品牌行 + 问句 + 输入框 + 问模型入口 + 最近收藏」。",
      "搜索结果放真实命中的那一句，只用真实证据。",
      "原生 prop 需要颜色字符串时从 usePalette() 取。"
    ],
    "donts": [
      "不要引入第二个字体、渐变、印章与倾斜文字。",
      "不要在首页放两个输入框。",
      "不要给列表加卡片底或箭头。",
      "不要手写 StyleSheet：样式一律走 className。"
    ]
